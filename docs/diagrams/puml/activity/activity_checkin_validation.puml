@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 11

skinparam activity {
    BackgroundColor #F0FDF4
    BorderColor #16A34A
    FontColor #0F172A
    BarColor #15803D
    DiamondBackgroundColor #FEF9C3
    DiamondBorderColor #CA8A04
}

title Диаграмма деятельности: Оптический чекин и офлайн-валидация билета (Задание 4)

|Волонтер со сканером|
start
:Открытие экрана "Оптический сканер";
:Инициализация видеопотока камеры (60 fps);
:Наведение видоискателя на QR-код участника;

|Клиентский модуль сканера|
:Оптический захват кадра и декодирование QR (<120 мс);
:Парсинг полезной нагрузки (ticket_id, user_hash, salt, signature);

if (Есть интернет-соединение?) then (онлайн-режим)
    :Отправка HTTPS POST /api/v1/tickets/checkin;
    |Серверный шлюз|
    :Проверка цифровой подписи HMAC-SHA256;
    :Поиск записи билета в СУБД;
    if (Статус == 'CHECKED_IN'?) then (повторный проход)
        :Возврат ошибки 409 Conflict (Duplicate Pass);
        |Клиентский модуль сканера|
        :ЖЕЛТЫЙ экран + вибро-сигнал 3 импульса;
        :Вывод: "Билет уже погашен в 18:04:12 волонтером Дарья";
    else (билет валиден)
        :Обновление статуса на 'CHECKED_IN';
        :Запись таймстемпа и volunteer_id;
        :Возврат 200 OK (Attendee Info);
        |Клиентский модуль сканера|
        :ЗЕЛЕНЫЙ экран + тактильный Haptic Success (50 мс);
        :Отображение имени гостя, вуза и категории бейджа;
    endif
else (офлайн-режим)
    |Клиентский модуль сканера|
    :Чтение локального кеша мероприятия (SQLite/SecureStore);
    :Локальная валидация HMAC открытым ключом события;
    if (Подпись верна?) then (да)
        :Проверка локального лога оффлайн-чекинов;
        if (Уже отмечен локально?) then (дубликат)
            :ЖЕЛТЫЙ экран + предупреждение о повторе;
        else (успех)
            :Добавление в локальную очередь синхронизации;
            :ЗЕЛЕНЫЙ экран + тактильный вибро-клик;
        endif
    else (недействителен)
        :КРАСНЫЙ экран + резкая двойная вибрация;
        :Сообщение: "Поддельный или поврежденный токен";
    endif
endif

stop

@enduml
